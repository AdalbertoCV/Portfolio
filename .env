# Create React App inlines any image under 10kB as a data URI in the JavaScript
# bundle. That is a good trade for a handful of icons and a terrible one for a
# wall of nine hundred and thirty: it put every mark on the wall into the main
# bundle, which doubled it, so a visitor who never scrolls to the stack still
# paid for all of it before the page rendered.
#
# At zero they stay files. The tiles already carry loading="lazy", so the
# browser fetches a mark when the mark is about to be seen, and caches it.
IMAGE_INLINE_SIZE_LIMIT=0
